# Supabase (publiek)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase (server-only)
SUPABASE_SECRET_KEY=your-service-role-key

# Auth0 — Regular Web Application (NIET de tenant-naam als CLIENT_ID!)
# Genereer AUTH0_SECRET met: openssl rand -hex 32
# EU-tenant: jouw-tenant.eu.auth0.com  |  US-tenant: jouw-tenant.auth0.com
AUTH0_SECRET=your-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-web-app-client-id
AUTH0_CLIENT_SECRET=your-web-app-client-secret

# Auth0 — Machine-to-Machine app (Management API)
# Vereiste scopes (Applications → M2M app → APIs → Auth0 Management API):
#   create:users, read:users, update:users, update:users_app_metadata
# Voor npm run setup:auth0-grants (password-realm login):
#   read:clients, update:clients
# Optioneel voor testadmin-rol in seed:auth0-users:
#   read:roles, create:role_members
AUTH0_MANAGEMENT_CLIENT_ID=your-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-m2m-client-secret

# Auth-wachtwoordvalidatie in de app (true/onzet = min. 6 tekens; false = alleen niet-leeg)
AUTH_STRICT_PASSWORD=true

# Optioneel: seed-scripts (legacy Supabase-only users)
SEED_USER_PASSWORD=change-me

# Overige
OPENAI_API_KEY=your-openai-key
