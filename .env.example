# Supabase (publiek)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase (server-only)
# Auth Admin (ban/delete) werkt betrouwbaar met de legacy JWT service_role key.
# Opaque sb_secret_… mag als fallback, maar kan intermittent bad_jwt geven.
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt
SUPABASE_SECRET_KEY=your-sb-secret-key

# Auth-wachtwoordvalidatie in de app (true/onzet = min. 6 tekens; false = alleen niet-leeg)
AUTH_STRICT_PASSWORD=true

# Seed-scripts (npm run seed:users)
SEED_USER_PASSWORD=change-me

# Overige
OPENAI_API_KEY=your-openai-key
